{
  "expo": {
    "name": "iwillbe.me",
    "slug": "iwillbe-me",
    "version": "0.2.0",
    "scheme": "iwillbe",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "me.iwillbe.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "me.iwillbe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F6F2"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "iwillbe.me"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F7F6F2"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#48634F"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your private iwillbe.me practice with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f9f9f7f0-fcc9-4a93-b37b-2dd6dd3358e2"
      }
    }
  }
}
