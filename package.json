{
  "name": "iwillbe-me",
  "version": "0.2.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "0.4.2",
    "@expo-google-fonts/fraunces": "0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "expo": "58.0.16",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-font": "58.0.9",
    "expo-haptics": "58.0.7",
    "expo-linking": "58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "58.1.5",
    "expo-router": "58.0.24",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.10",
    "expo-status-bar": "58.0.3",
    "phosphor-react-native": "3.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src tests",
    "build": "expo export --platform web && node scripts/web-shell.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write app src tests scripts supabase/functions",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:browser": "node scripts/verify-ui.mjs && node scripts/verify-auth.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "private": true
}
